# Copy to .env and fill in — .env is gitignored.
# Never commit real keys.

# Anthropic — for investigator agent (Phase 2+)
ANTHROPIC_API_KEY=sk-ant-...

# Alchemy — for Polygon RPC wallet metadata (Phase 1+)
ALCHEMY_API_KEY=...

# Telegram — optional, alerts only (Phase 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database path — default ./polysim.db
POLYSIM_DB_PATH=./polysim.db

# Config path — default ./config.yml
POLYSIM_CONFIG_PATH=./config.yml

# Log level — DEBUG / INFO / WARNING / ERROR
POLYSIM_LOG_LEVEL=INFO
